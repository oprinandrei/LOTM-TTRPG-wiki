---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import type { ImageMetadata } from 'astro';

const allCharacters = await getCollection('characters');
const characters = allCharacters
  .filter(c => c.id !== '_template')
  .sort((a, b) => a.data.basicInformation.name.localeCompare(b.data.basicInformation.name));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const symbolModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/symbol_*.webp',
  { eager: true }
);

function getSymbolImage(pathway: string): ImageMetadata | undefined {
  const slug = pathway.toLowerCase().replace(/\s+/g, '_');
  const key = slug === 'twilight_giant'
    ? `/src/assets/images/symbol_twilght_giant.webp`
    : `/src/assets/images/symbol_${slug}.webp`;
  return symbolModules[key]?.default;
}
---

<BaseLayout title="Characters — Lord of Mysteries TTRPG">
  <main class="container">
    <SectionHeader
      title="Characters"
      subtitle="Beyonders walking the path toward mystery."
    />

    {characters.length === 0 ? (
      <p class="empty">No characters have been added yet.</p>
    ) : (
      <div class="character-grid">
        {characters.map((character) => {
          const { name, pathway, sequence, race, occupation } = character.data.basicInformation;
          const symbolImage = getSymbolImage(pathway);
          return (
            <a href={`${base}/characters/${character.id}`} class="character-card">
              <div class="card-icon">
                {symbolImage ? (
                  <Image src={symbolImage} alt={`${pathway} symbol`} width={48} height={48} />
                ) : (
                  <span class="icon-fallback">✦</span>
                )}
              </div>
              <div class="card-body">
                <h2 class="card-name">{name}</h2>
                <p class="card-pathway">Seq {sequence} · {pathway}</p>
                {(race || occupation) && (
                  <p class="card-sub">{[race, occupation].filter(Boolean).join(' · ')}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem var(--spacing-gutter);
  }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin-top: 3rem;
  }

  .character-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  /* ── Card ── */
  .character-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background-color: var(--color-background-card);
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .character-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--color-primary) 25%, transparent);
    transform: translateY(-2px);
  }

  /* ── Icon ── */
  .card-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-md);
    background-color: var(--color-background-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .character-card:hover .card-icon {
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .card-icon img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .icon-fallback {
    font-size: 1.25rem;
    color: var(--color-primary-light);
    opacity: 0.5;
  }

  /* ── Body ── */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .card-name {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-heading);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-pathway {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-light);
    margin: 0;
  }

  .card-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
