---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ComingSoon from '../../components/ui/ComingSoon.astro';
import type { ImageMetadata } from 'astro';

const pathways = await getCollection('pathways');
pathways.sort((a, b) => a.data.name.localeCompare(b.data.name));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const activePaths = new Set(['fool', 'darkness', 'death']);

// Map pathway header images by pathway slug
const pathwayModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/pathway_*.webp',
  { eager: true }
);
const tarotImages: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(pathwayModules).map(([path, mod]) => {
    const slug = path.replace('/src/assets/images/pathway_', '').replace('.webp', '');
    return [slug, mod.default];
  })
);
---

<BaseLayout title="Pathways — Lord of Mysteries TTRPG">
  <main class="container">
    <SectionHeader
      title="Pathways"
      subtitle="Each pathway grants a unique set of Beyonder abilities across sequences."
    />

    <div class="pathway-grid">
      {pathways.map((pathway) => {
        const image = tarotImages[pathway.id];
        const highestSeq = pathway.data.sequences[0];
        return (
          <a href={`${base}/pathways/${pathway.id}`} class="pathway-card">
            {image && (
              <div class="card-image">
                <Image src={image} alt={pathway.data.name} width={220} height={330} />
              </div>
            )}
            <div class="card-body">
              <h2 class="card-name">{pathway.data.name}</h2>
              {pathway.data.spoiler_free_name && (
                <p class="card-entry">Seq {highestSeq?.number} · {pathway.data.spoiler_free_name}</p>
              )}
              <p class="card-desc">{pathway.data.description}</p>
              <span class="card-meta">{pathway.data.sequences.length} sequences</span>
              {!activePaths.has(pathway.id) && <ComingSoon />}
            </div>
          </a>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem var(--spacing-gutter);
  }

  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  /* ── Card ── */
  .pathway-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background-card);
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pathway-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--color-primary) 25%, transparent);
    transform: translateY(-2px);
  }

  /* ── Image ── */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background-color: var(--color-background-surface);
  }

  .card-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pathway-card:hover .card-image img {
    transform: scale(1.04);
  }

  /* ── Body ── */
  .card-body {
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .card-name {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-heading);
    margin: 0;
  }

  .card-entry {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-light);
    margin: 0;
  }

  .card-desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0.25rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: inline-block;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
