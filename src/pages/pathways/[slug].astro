---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const pathways = await getCollection('pathways');
  return pathways.map((pathway) => ({
    params: { slug: pathway.id },
    props: { pathway },
  }));
}

const { pathway } = Astro.props;

// Load pathway header image
const pathwayModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/pathway_*.webp',
  { eager: true }
);
const symbolModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/symbol_*.webp',
  { eager: true }
);

const headerImage = pathwayModules[`/src/assets/images/pathway_${pathway.id}.webp`]?.default;
// Handle typo in file: symbol_twilght_giant.webp
const symbolKey = pathway.id === 'twilight_giant'
  ? `/src/assets/images/symbol_twilght_giant.webp`
  : `/src/assets/images/symbol_${pathway.id}.webp`;
const symbolImage = symbolModules[symbolKey]?.default;
---

<BaseLayout
  title={`${pathway.data.name} — Lord of Mysteries TTRPG`}
  description={pathway.data.description}
>
  <!-- Pathway header -->
  <div class="pathway-hero" style={symbolImage ? `--hero-img: url(${symbolImage.src})` : ''}>
    <div class="hero-overlay" />
    <div class="hero-content">
      {symbolImage && (
        <div class="symbol-frame">
          <Image src={symbolImage} alt={`${pathway.data.name} symbol`} width={64} height={64} />
        </div>
      )}
      <div class="hero-text">
        <div class="hero-badges">
          <Badge label={pathway.data.name} variant="pathway" />
          {pathway.data.spoiler_free_name && (
            <Badge label={`Entry: ${pathway.data.spoiler_free_name}`} variant="sequence" />
          )}
        </div>
        <h1>{pathway.data.name}</h1>
        <p class="hero-desc">{pathway.data.description}</p>
      </div>
    </div>
  </div>

  <!-- Sequences -->
  <main class="container">
    <SectionHeader
      title="Sequences"
      subtitle={`${pathway.data.sequences.length} known sequences — from entry level down to Sequence 1.`}
    />

    <div class="sequences">
      {pathway.data.sequences.map((seq) => (
        <div class="sequence-card">
          <div class="seq-header">
            <span class="seq-number">Seq {seq.number}</span>
            <h2 class="seq-name">{seq.name}</h2>
          </div>

          {seq.potion && (
            <div class="seq-section">
              <h3 class="section-label">Potion</h3>
              <p class="seq-potion">{seq.potion}</p>
            </div>
          )}

          {seq.ingredients && seq.ingredients.length > 0 && (
            <div class="seq-section">
              <h3 class="section-label">Ingredients</h3>
              <ul class="ingredient-list">
                {seq.ingredients.map((ing) => <li>{ing}</li>)}
              </ul>
            </div>
          )}

          {seq.abilities && seq.abilities.length > 0 && (
            <div class="seq-section">
              <h3 class="section-label">Abilities</h3>
              <div class="ability-list">
                {seq.abilities.map((ability) => (
                  <div class="ability">
                    <span class="ability-name">{ability.name}</span>
                    <p class="ability-desc">{ability.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  /* ── Hero ── */
  .pathway-hero {
    position: relative;
    min-height: 260px;
    display: flex;
    align-items: flex-end;
    background-image: var(--hero-img, none);
    background-size: cover;
    background-position: center top;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-background-deep) 10%, transparent) 0%,
      var(--color-background-deep) 100%
    );
  }

  .hero-content {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    padding: 2rem var(--spacing-gutter);
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .symbol-frame {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-lg);
    background-color: var(--color-background-card);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .symbol-frame img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .hero-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .hero-text h1 {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-heading);
    margin: 0 0 0.5rem;
  }

  .hero-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 600px;
    line-height: 1.55;
  }

  /* ── Container ── */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem var(--spacing-gutter);
  }

  /* ── Sequences ── */
  .sequences {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sequence-card {
    background-color: var(--color-background-card);
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .seq-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-background-surface);
    border-bottom: 1px solid var(--color-material-outline);
  }

  .seq-number {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary-light);
    background-color: var(--color-primary-container);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    white-space: nowrap;
  }

  .seq-name {
    font-family: var(--font-headline);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-heading);
    margin: 0;
  }

  .seq-section {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-material-outline) 50%, transparent);
  }

  .seq-section:last-child {
    border-bottom: none;
  }

  .section-label {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
  }

  .seq-potion {
    font-size: 0.875rem;
    color: var(--color-text-default);
    font-style: italic;
    line-height: 1.55;
    margin: 0;
  }

  .ingredient-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ingredient-list li {
    font-size: 0.875rem;
    color: var(--color-text-default);
    padding-left: 1rem;
    position: relative;
  }

  .ingredient-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary-light);
  }

  /* ── Abilities ── */
  .ability-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ability {
    background-color: var(--color-background-surface);
    border-left: 2px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 0.6rem 0.875rem;
  }

  .ability-name {
    display: block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-light);
    margin-bottom: 0.3rem;
  }

  .ability-desc {
    font-size: 0.875rem;
    color: var(--color-text-default);
    line-height: 1.55;
    margin: 0;
    white-space: pre-line;
  }
</style>
