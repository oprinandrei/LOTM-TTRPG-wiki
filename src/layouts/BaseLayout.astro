---
import '../styles/global.css';
import Search from '../components/ui/Search.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lord of Mysteries — TTRPG',
  description = 'A Lord of Mysteries-inspired TTRPG reference for GM and players.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href={`${base}/favicon.webp`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Serif:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="site-nav" data-pagefind-ignore>
      <a href={`${base}/`} class="nav-brand">Lord of Mysteries</a>
      <div class="nav-links">
        <a href={`${base}/pathways`}>Pathways</a>
        <a href={`${base}/characters`}>Characters</a>
        <a href={`${base}/rules`}>Rules</a>
      </div>
      <Search />
    </nav>

    <slot />
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-gutter);
    height: 56px;
    background-color: var(--color-background-surface);
    border-bottom: 1px solid var(--color-material-outline);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-brand {
    font-family: var(--font-headline);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary-light);
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-primary-light);
  }

  /* ── Mobile nav: two-row layout ── */
  @media (max-width: 599px) {
    .site-nav {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0;
      padding-bottom: 0;
    }

    .nav-brand {
      flex: 1;
      padding: 0.875rem 0;
    }

    /* Search button stays in row 1, after brand */
    :global(.search-trigger) {
      order: 2;
    }

    /* Nav links drop to row 2, full width, centred */
    .nav-links {
      order: 3;
      flex-basis: 100%;
      justify-content: center;
      gap: 1.5rem;
      padding: 0.5rem 0 0.625rem;
      border-top: 1px solid var(--color-material-outline);
    }
  }
</style>
