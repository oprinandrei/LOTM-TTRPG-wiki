---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<button class="search-trigger" id="search-open" aria-label="Search (press / to open)">
  <svg class="search-trigger__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <span class="search-trigger__label">Search</span>
  <kbd class="search-trigger__kbd">/</kbd>
</button>

<div class="search-overlay" id="search-overlay" aria-hidden="true">
  <div class="search-dialog" role="dialog" aria-label="Search">
    <div class="search-bar">
      <svg class="search-bar__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        id="search-input"
        type="search"
        class="search-bar__input"
        placeholder="Search pathways, rules, abilities…"
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close" class="search-bar__close" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div id="search-results" class="search-results" role="listbox"></div>

    <div class="search-hints">
      <span><kbd>↑↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<script define:vars={{ base }}>
  (function () {
    let pf = null;
    let activeIndex = -1;

    const placeholderHTML =
      '<div class="search-placeholder">' +
      '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' +
      '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' +
      '</svg>' +
      '<p>Type to search pathways, rules, and abilities</p>' +
      '</div>';

    async function loadPagefind() {
      if (pf !== null) return pf;
      try {
        pf = await import(base + '/pagefind/pagefind.js');
        await pf.init();
      } catch (_) {
        pf = false;
      }
      return pf;
    }

    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');

    function openSearch() {
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      results.innerHTML = placeholderHTML;
      input.focus();
      loadPagefind();
    }

    function closeSearch() {
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.value = '';
      results.innerHTML = '';
      activeIndex = -1;
    }

    document.getElementById('search-open').addEventListener('click', openSearch);
    document.getElementById('search-close').addEventListener('click', closeSearch);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeSearch();
    });

    document.addEventListener('keydown', function (e) {
      const isOpen = overlay.getAttribute('aria-hidden') === 'false';

      if (!isOpen) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
          e.preventDefault();
          openSearch();
        } else if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        return;
      }

      if (e.key === 'Escape') {
        closeSearch();
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const items = Array.from(results.querySelectorAll('.result-item'));
        if (!items.length) return;
        activeIndex = e.key === 'ArrowDown'
          ? Math.min(activeIndex + 1, items.length - 1)
          : Math.max(activeIndex - 1, -1);
        if (activeIndex === -1) {
          input.focus();
        } else {
          items[activeIndex].focus();
        }
      }
    });

    let debounce;
    input.addEventListener('input', function () {
      clearTimeout(debounce);
      activeIndex = -1;
      const q = input.value.trim();
      if (!q) { results.innerHTML = placeholderHTML; return; }

      debounce = setTimeout(async function () {
        const pagefind = await loadPagefind();
        if (!pagefind) {
          results.innerHTML =
            '<div class="search-empty">' +
            '<p class="search-empty__main">Search index not available</p>' +
            '<p class="search-empty__hint">Run <code>npm run build</code> to generate the index</p>' +
            '</div>';
          return;
        }
        const search = await pagefind.search(q);
        if (!search.results.length) {
          results.innerHTML =
            '<div class="search-empty">' +
            '<p class="search-empty__main">No results for <em>"' + q + '"</em></p>' +
            '<p class="search-empty__hint">Try a different term, or browse the pathways directly</p>' +
            '</div>';
          return;
        }

        function cleanTitle(raw) {
          return raw.replace(/\s*[—–]\s*.*(TTRPG|Mysteries).*$/i, '').trim();
        }

        const data = await Promise.all(search.results.slice(0, 8).map(function (r) { return r.data(); }));

        results.innerHTML = data.map(function (item, i) {
          const section = (item.meta && item.meta.type) ? item.meta.type : '';
          const title = cleanTitle((item.meta && item.meta.title) ? item.meta.title : 'Untitled');
          return '<a href="' + item.url + '" class="result-item" tabindex="-1" data-index="' + i + '">' +
            '<div class="result-header">' +
            (section ? '<span class="result-section">' + section + '</span>' : '') +
            '<span class="result-title">' + title + '</span>' +
            '</div>' +
            '<div class="result-preview">' +
            '<span class="result-excerpt">' + item.excerpt + '</span>' +
            '</div>' +
            '</a>';
        }).join('<hr class="result-divider">');
      }, 180);
    });
  })();
</script>

<style is:global>
  /* ── Trigger button ── */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-material-outline);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .search-trigger:hover {
    color: var(--color-primary-light);
    border-color: var(--color-primary);
  }

  .search-trigger__icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .search-trigger__label {
    display: none;
  }

  @media (min-width: 480px) {
    .search-trigger__label {
      display: inline;
    }
  }

  .search-trigger__kbd {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-muted);
    background-color: var(--color-background-deep);
    border: 1px solid var(--color-material-outline);
    border-radius: 3px;
    padding: 1px 4px;
    display: none;
  }

  @media (min-width: 640px) {
    .search-trigger__kbd {
      display: inline;
    }
  }

  /* ── Overlay ── */
  .search-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(5, 4, 10, 0.82);
    backdrop-filter: blur(4px);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 6vh 1rem 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .search-overlay[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Dialog ── */
  .search-dialog {
    width: 100%;
    max-width: 600px;
    background-color: var(--color-background-surface);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    transform: translateY(-10px);
    transition: transform 0.15s ease;
  }

  .search-overlay[aria-hidden="false"] .search-dialog {
    transform: translateY(0);
  }

  /* ── Search bar ── */
  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--color-material-outline);
  }

  .search-bar__icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-bar__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-default);
    padding: 0.875rem 0;
    min-width: 0;
  }

  .search-bar__input::placeholder {
    color: var(--color-text-muted);
  }

  /* hide browser-native clear button */
  .search-bar__input::-webkit-search-cancel-button {
    display: none;
  }

  .search-bar__close {
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease;
  }

  .search-bar__close:hover {
    color: var(--color-text-default);
  }

  /* ── Results ── */
  .search-results {
    max-height: 420px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── Placeholder (idle state) ── */
  .search-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem 2rem;
    color: var(--color-text-muted);
  }

  .search-placeholder svg {
    opacity: 0.2;
  }

  .search-placeholder p {
    font-size: 0.875rem;
    margin: 0;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Empty / no-results state ── */
  .search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .search-empty__main {
    font-size: 0.9rem;
    color: var(--color-text-default);
    margin: 0;
  }

  .search-empty__main em {
    font-style: normal;
    color: var(--color-primary-light);
  }

  .search-empty__hint {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .search-empty__hint code {
    font-family: monospace;
    font-size: 0.75rem;
    background-color: var(--color-background-deep);
    border: 1px solid var(--color-material-outline);
    border-radius: 3px;
    padding: 0 4px;
    color: var(--color-primary-light);
  }

  /* ── Divider between results ── */
  .result-divider {
    border: none;
    border-top: 1px solid var(--color-material-outline);
    margin: 0;
  }

  /* ── Result item ── */
  .result-item {
    display: block;
    text-decoration: none;
    outline: none;
    transition: background-color 0.1s ease;
  }

  .result-item:hover,
  .result-item:focus {
    background-color: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }

  /* Page identity section — section label stacked above title */
  .result-header {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.875rem 1rem 0.6rem;
  }

  .result-section {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-light);
  }

  .result-title {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: 1.3;
  }

  /* Text preview — left-border accent, one line of context */
  .result-preview {
    margin: 0 1rem 0.875rem 1rem;
    padding: 0.3rem 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .result-excerpt {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Highlight matched text */
  .result-excerpt mark {
    background: transparent;
    color: var(--color-primary-light);
    font-weight: 600;
  }

  /* ── Hints bar ── */
  .search-hints {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--color-material-outline);
    background-color: color-mix(in srgb, var(--color-background-deep) 40%, transparent);
  }

  .search-hints span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    font-family: var(--font-label);
  }

  .search-hints kbd {
    font-family: var(--font-body);
    font-size: 0.6rem;
    background-color: var(--color-background-surface);
    border: 1px solid var(--color-material-outline);
    border-radius: 3px;
    padding: 1px 4px;
    color: var(--color-text-default);
  }
</style>
